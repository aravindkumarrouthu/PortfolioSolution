@{
    ViewData["Title"] = "Home";
}
<!-- HERO VIDEO SECTION -->
<section class="py-5 glass-section" data-aos="fade-up">
    <video autoplay muted loop playsinline>
        <source src="~/videos/hero-bg.mp4" type="video/mp4">
    </video>

    <div class="card modern-card" data-aos="zoom-in">
        <div class="container text-center">
            <h1 class="fade-text">Hi, I'm Aravind Kumar</h1>
            <p class="lead mt-3">
                Data Analyst | .NET Full Stack Developer
            </p>

            <a href="/Home/Projects" class="btn gradient-btn btn-lg">View Projects</>
                View Projects
            </a>

            <a href="~/resume/Aravind_Kumar_Resume.pdf"
               class="btn btn-success btn-lg mt-3 ms-2"
               download>
                Download Resume
            </a>
        </div>
    </div>
</section>


<!-- ABOUT SHORT INTRO -->
<section class="py-5">
    <div class="container text-center">
        <h2 class="fw-bold">Who Am I?</h2>
        <p class="mt-3 text-muted">
            I am a passionate Data Analyst and .NET Full Stack Developer
            skilled in Python, SQL, Power BI, ASP.NET Core, and C#.
            I love converting data into insights and building scalable web applications.
        </p>
    </div>
</section>

<!-- SKILLS SECTION -->
<section class="bg-light py-5">
    <div class="container">
        <h2 class="text-center fw-bold mb-4">My Skills</h2>

        <div class="row text-center">
            <div class="col-md-4 mb-3">
                <div class="card shadow-sm">
                    <div class="card-body">
                        <h5 class="card-title">Data Analysis</h5>
                        <p class="card-text">
                            Python, Pandas, NumPy, SQL, Power BI, Excel
                        </p>
                    </div>
                </div>
            </div>

            <div class="col-md-4 mb-3">
                <div class="card shadow-sm">
                    <div class="card-body">
                        <h5 class="card-title">Backend</h5>
                        <p class="card-text">
                            C#, ASP.NET Core MVC, Web API, Entity Framework
                        </p>
                    </div>
                </div>
            </div>

            <div class="col-md-4 mb-3">
                <div class="card shadow-sm">
                    <div class="card-body">
                        <h5 class="card-title">Frontend</h5>
                        <p class="card-text">
                            HTML, CSS, JavaScript, Bootstrap
                        </p>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- PROJECT HIGHLIGHTS -->
<section class="py-5">
    <div class="container">
        <h2 class="text-center fw-bold mb-4">Featured Projects</h2>

        <div class="row">
            <div class="col-md-6 mb-3">
                <div class="card shadow-sm">
                    <div class="card-body">
                        <h5 class="card-title">Sales Data Analysis</h5>
                        <p class="card-text">
                            Analyzed sales data using Python, SQL, and Power BI
                            to identify trends and improve business decisions.
                        </p>
                    </div>
                </div>
            </div>

            <div class="col-md-6 mb-4" data-aos="fade-right">
                <div class="card shadow-sm">
                    <div class="card-body">
                        <h5 class="card-title">ASP.NET Portfolio Website</h5>
                        <p class="card-text">
                            Built a responsive portfolio website using
                            ASP.NET Core MVC and Bootstrap.
                        </p>
                    </div>
                </div>
            </div>
        </div>

        <div class="text-center mt-4">
            <a href="/Home/Projects" class="btn btn-primary">
                See All Projects
            </a>
        </div>
    </div>
</section>
