@{
    ViewData["Title"] = "Skills";
}

<section class="bg-light py-5">
    <div class="container">
        <h1 class="text-center fw-bold mb-5">My Skills</h1>

        <div class="row">

            <!-- DATA ANALYSIS -->
            <div class="col-md-4 mb-4">
                <div class="card shadow h-100">
                    <div class="card-body">
                        <h4 class="card-title">Data Analysis</h4>
                        <ul class="list-unstyled mt-3">
                            <li>✔ Python (Pandas, NumPy, Matplotlib)</li>
                            <li>✔ SQL (Joins, Subqueries, Window Functions)</li>
                            <li>✔ Power BI (DAX, Dashboards)</li>
                            <li>✔ Excel (Pivot Tables, VLOOKUP)</li>
                        </ul>
                    </div>
                </div>
            </div>

            <!-- BACKEND -->
            <div class="col-md-4 mb-4">
                <div class="card shadow h-100">
                    <div class="card-body">
                        <h4 class="card-title">Backend Development</h4>
                        <ul class="list-unstyled mt-3">
                            <li>✔ C#</li>
                            <li>✔ ASP.NET Core MVC</li>
                            <li>✔ ASP.NET Web API</li>
                            <li>✔ Entity Framework Core</li>
                        </ul>
                    </div>
                </div>
            </div>

            <!-- FRONTEND -->
            <div class="col-md-4 mb-4">
                <div class="card shadow h-100">
                    <div class="card-body">
                        <h4 class="card-title">Frontend Development</h4>
                        <ul class="list-unstyled mt-3">
                            <li>✔ HTML5</li>
                            <li>✔ CSS3</li>
                            <li>✔ JavaScript</li>
                            <li>✔ Bootstrap 5</li>
                        </ul>
                    </div>
                </div>
            </div>

        </div>
    </div>
</section>
